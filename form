<!DOCTYPE html>
<html>
<head>
<title>Employee Bio-Data Form</title>

<style>

body{
    font-family: Arial;
}

.container{
    width: 450px;
    margin: auto;
    margin-top: 40px;
    border: 1px solid black;
    padding: 20px;
    text-align: center;
}

input,select{
    width: 100%;
    padding: 8px;
    margin-top: 5px;
}

</style>

<script>

function validateForm()
{
    let fname =
    document.getElementById("fname").value;

    let lname =
    document.getElementById("lname").value;

    let address =
    document.getElementById("address").value;

    let email =
    document.getElementById("email").value;

    if(fname=="" || lname=="" ||
       address=="" || email=="")
    {
        alert("All fields are required");
        return false;
    }

    return true;
}

</script>

</head>

<body>

<div class="container">

<h2>Employee Bio – Data Form</h2>

<form onsubmit="return validateForm();">

<label>First Name</label>
<input type="text"
id="fname"
required>

<br><br>

<label>Last Name</label>
<input type="text"
id="lname"
required>

<br><br>

<label>Address</label>
<input type="text"
id="address"
required>

<br><br>

<label>Email ID</label>
<input type="email"
id="email"
required>

<br><br>

<label>Membership Duration</label>

<select required>

<option value="">
Select Membership
</option>

<option>1 Year</option>
<option>2 Years</option>
<option>5 Years</option>

</select>

<br><br>

<input type="submit" value="Submit">

<input type="reset" value="Reset">

</form>

</div>

</body>
</html>
